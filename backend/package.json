{
  "name": "piko-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Piko CloudFlare Workers backend (account control plane)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply piko-db --local",
    "migrate:remote": "wrangler d1 migrations apply piko-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.31",
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.3",
    "vitest": "2.1.4",
    "wrangler": "^3.86.0"
  },
  "packageManager": "pnpm@9.12.3"
}
